{
	// Franklin Kos Trip! — holiday packing planner
	// Served at https://holiday.page-one.events (Cloudflare Worker + static assets + D1)
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "franklin-kos-trip",
	"main": "src/worker.js",
	"compatibility_date": "2026-06-01",
	// Only reachable on the custom domain (no workers.dev / preview URLs)
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "holiday.page-one.events",
			"custom_domain": true
		}
	],
	// Static front end. The Worker runs first on every request so it can enforce the password.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "none",
		"not_found_handling": "none"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "franklin-kos-trip",
			// Filled in automatically by `npm run setup`
			"database_id": "8b52f71b-0bd8-407a-b4ff-4c617e78c130"
		}
	]
}